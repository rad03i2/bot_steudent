# ===== إلزامي =====
# توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=

# مفتاح Claude API من https://platform.claude.com (بدونه يعمل البوت بالأوامر فقط)
ANTHROPIC_API_KEY=

# ===== اختياري =====
# النموذج المستخدم لفهم الرسائل (claude-haiku-5-5 أرخص بكثير)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# المنطقة الزمنية
TIMEZONE=Asia/Baghdad

# أول يوم في الأسبوع الدراسي: sunday أو saturday أو monday
WEEK_START=sunday

# أسماء الأشهر: levantine (تشرين الثاني) أو standard (نوفمبر)
MONTH_STYLE=levantine

# مكان قاعدة البيانات
DB_PATH=data/study_bot.db

# أرقام القروبات المسموحة مفصولة بفواصل (احصل عليه بالأمر /chatid). اتركه فارغاً للسماح للجميع
ALLOWED_CHAT_IDS=

# في القروب: لا يُرسل للذكاء الاصطناعي إلا الرسائل التي فيها كلمات دراسية (لتوفير التكلفة)
GROUP_PREFILTER=true
