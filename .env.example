# ===== إلزامي =====
# توكن البوت من @BotFather (مجاني)
TELEGRAM_BOT_TOKEN=

# ===== اختياري (مدفوع) =====
# اتركه فارغاً ليعمل البوت مجاناً بالمحلّل المحلي.
# إذا وضعت مفتاح Claude API يصير فهم الرسائل أذكى (يحتاج: pip install -r requirements-ai.txt)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# ===== إعدادات عامة =====

# المنطقة الزمنية
TIMEZONE=Asia/Baghdad

# أول يوم في الأسبوع الدراسي: sunday أو saturday أو monday
WEEK_START=sunday

# أسماء الأشهر: levantine (تشرين الثاني) أو standard (نوفمبر)
MONTH_STYLE=levantine

# مكان قاعدة البيانات
DB_PATH=data/study_bot.db

# أرقام القروبات المسموحة مفصولة بفواصل (احصل عليه بالأمر /chatid). اتركه فارغاً للسماح للجميع
ALLOWED_CHAT_IDS=

# في القروب: لا يحلّل البوت إلا الرسائل التي فيها كلمات دراسية
GROUP_PREFILTER=true

# التذكيرات التلقائية في القروب
REMINDERS=true
# ملخص الصباح (مواعيد اليوم + الامتحانات القريبة)
MORNING_TIME=07:00
# تذكير المساء (مواعيد الغد)، وفي آخر يوم بالأسبوع يُرسل ملخص الأسبوع القادم
EVENING_TIME=20:00
